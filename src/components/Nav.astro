---
const navLinks = [
  { href: '/capabilities', label: 'Capabilities' },
  { href: '/approach', label: 'Approach' },
  { href: '/about', label: 'About' },
  { href: '/insights', label: 'Insights' },
  { href: '/research', label: 'Research' },
  { href: '/procurement', label: 'Procurement' },
  { href: '/contact', label: 'Contact' },
];
const { pathname } = Astro.url;
---

<header id="site-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div style="max-width:1200px" class="mx-auto px-6 flex items-center justify-between h-16">
    <a href="/" aria-label="GridSphere home" class="hover:opacity-75 transition-opacity no-underline">
      <img src="/logo.png" alt="GridSphere" height="40" style="height:72px;width:auto;display:block;" />
    </a>
    <nav aria-label="Primary navigation">
      <ul class="hidden md:flex items-center gap-7 list-none m-0 p-0">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              style={`font-family:'General Sans Variable','General Sans','Bricolage Grotesque Variable',sans-serif;font-size:0.875rem;font-weight:500;text-decoration:none;transition:color 0.2s ease;${
                pathname.startsWith(link.href)
                  ? 'color:var(--accent);'
                  : 'color:var(--text-muted);'
              }`}
              onmouseover={`if(!this.classList.contains('active'))this.style.color='var(--text)'`}
              onmouseout={`if(!this.classList.contains('active'))this.style.color='var(--text-muted)'`}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <button
        id="mobile-menu-btn"
        class="md:hidden transition-colors"
        style="color:var(--text-muted);"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="2" y1="5" x2="18" y2="5"/>
          <line x1="2" y1="10" x2="18" y2="10"/>
          <line x1="2" y1="15" x2="18" y2="15"/>
        </svg>
      </button>
    </nav>
  </div>

  <div id="mobile-menu" class="md:hidden hidden" style="background:rgba(30,45,92,0.98);border-top:1px solid var(--border);">
    <ul class="list-none m-0 p-0 px-6 py-5 flex flex-col gap-4">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            style={`font-family:'General Sans Variable','General Sans','Bricolage Grotesque Variable',sans-serif;font-size:0.875rem;font-weight:500;text-decoration:none;display:block;padding:0.25rem 0;${
              pathname.startsWith(link.href) ? 'color:var(--accent);' : 'color:var(--text-muted);'
            }`}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<style>
  #site-nav {
    background: transparent;
    border-bottom: 1px solid transparent;
  }
  #site-nav.scrolled {
    background: rgba(30, 45, 92, 0.96);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom-color: var(--border);
  }
</style>

<script>
  const nav = document.getElementById('site-nav');
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  window.addEventListener('scroll', () => {
    nav?.classList.toggle('scrolled', window.scrollY > 20);
  }, { passive: true });

  btn?.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
  });
</script>
