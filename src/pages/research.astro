---
import Layout from '../layouts/Layout.astro';
import CtaBanner from '../components/CtaBanner.astro';

const stubs = [
  {
    title: 'What sensor data actually requires from your GIS before it\'s operationally useful',
  },
  {
    title: 'Vegetation management and the network model: why the data gap is bigger than it looks',
  },
  {
    title: 'The five integration points where drone data breaks down in utility operations',
  },
];
---

<Layout
  title="Research — GridSphere Utility Consulting"
  description="GridSphere maintains an active research practice focused on the problems that show up in the field — not in vendor decks."
>

  <!-- ══ HERO — navy ══ -->
  <section class="grid-overlay" style="padding:160px 0 96px;border-bottom:1px solid var(--border);background:var(--bg);">
    <div style="max-width:1200px;position:relative;z-index:1;" class="mx-auto px-6">
      <div class="hero-stagger flex flex-col gap-6" style="max-width:700px;">
        <span class="font-mono-label" style="color:var(--text-dim);">Research</span>
        <h1 class="font-display" style="font-size:clamp(3rem,6vw,5rem);font-weight:700;letter-spacing:-0.02em;line-height:1.0;color:var(--text);">We don't just consult on the gap. We study it.</h1>
        <p style="color:var(--text-muted);font-size:1.0625rem;line-height:1.75;">GridSphere maintains an active research practice focused on the problems that show up in the field — not in vendor decks.</p>
      </div>
    </div>
  </section>

  <!-- ══ 01 / FOCUS — navy ══ -->
  <section style="padding:96px 0;border-top:1px solid var(--border);background:var(--bg);">
    <div style="max-width:1200px" class="mx-auto px-6">
      <div style="display:grid;grid-template-columns:repeat(12,1fr);gap:1.5rem;align-items:start;">
        <div style="grid-column:1/4;" class="reveal-fade-up">
          <span class="font-mono-label" style="color:var(--text-dim);">01 / Focus</span>
        </div>
        <div style="grid-column:4/13;" class="reveal-slide-left">
          <h2 class="font-display mb-8" style="font-size:clamp(1.75rem,3.5vw,2.75rem);color:var(--text);">Where we work</h2>
          <p style="color:var(--text-muted);font-size:1.0625rem;line-height:1.8;max-width:640px;">The gap between what utility systems claim and what field crews experience isn't just an implementation problem. It's a data problem, a process problem, and increasingly, a sensor problem. Our research focuses on the seams — the handoffs between systems, the moments where topology meets terrain, where digital models meet physical infrastructure.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ 02 / ACTIVE RESEARCH — cream ══ -->
  <section style="padding:96px 0;border-top:1px solid var(--border-cream);background:var(--cream);">
    <div style="max-width:1200px" class="mx-auto px-6">
      <div style="display:grid;grid-template-columns:repeat(12,1fr);gap:1.5rem;align-items:start;">
        <div style="grid-column:1/4;" class="reveal-fade-up">
          <span class="font-mono-label" style="color:var(--text-muted-cream);">02 / Active Research</span>
        </div>
        <div style="grid-column:4/13;" class="reveal-slide-left flex flex-col gap-6">
          <h2 class="font-display" style="font-size:clamp(1.75rem,3.5vw,2.75rem);color:var(--text-on-cream);">In development</h2>
          <p style="color:var(--text-muted-cream);font-size:1.0625rem;line-height:1.8;max-width:640px;">We have active field research underway in operational technology sensing and vegetation management for electric distribution infrastructure. Details are not yet public.</p>
          <p style="color:var(--text-muted-cream);font-size:1.0625rem;line-height:1.8;font-style:italic;max-width:640px;">If you're working on adjacent problems and want to compare notes, we're open to that conversation.</p>
          <a href="/contact" class="font-mono-label" style="color:var(--text-on-cream);text-decoration:none;transition:color 0.2s ease;width:fit-content;"
             onmouseover="this.style.color='var(--signature)'" onmouseout="this.style.color='var(--text-on-cream)'">Get in touch →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ 03 / PUBLISHED THINKING — navy ══ -->
  <section style="padding:96px 0;border-top:1px solid var(--border);background:var(--bg);">
    <div style="max-width:1200px" class="mx-auto px-6">
      <div style="display:grid;grid-template-columns:repeat(12,1fr);gap:1.5rem;align-items:start;margin-bottom:3rem;">
        <div style="grid-column:1/4;" class="reveal-fade-up">
          <span class="font-mono-label" style="color:var(--text-dim);">03 / Published Thinking</span>
        </div>
        <div style="grid-column:4/13;" class="reveal-slide-left">
          <h2 class="font-display mb-3" style="font-size:clamp(1.75rem,3.5vw,2.75rem);color:var(--text);">From the field</h2>
          <p style="color:var(--text-muted);font-size:1.0625rem;line-height:1.75;">Notes and frameworks from active engagements. More coming.</p>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);" class="stagger-children">
        {stubs.map((stub) => (
          <article class="cap-card reveal-fade-up flex flex-col gap-5" style="background:var(--surface);">
            <div>
              <span class="font-mono-label" style="color:var(--text-dim);font-size:0.75rem;border:1px solid var(--border);padding:2px 8px;">[ DRAFT ]</span>
            </div>
            <h2 class="font-display" style="font-size:1.15rem;font-weight:500;letter-spacing:-0.01em;line-height:1.4;color:var(--text);text-transform:none;">{stub.title}</h2>
            <span class="font-mono-label" style="color:var(--text-dim);margin-top:auto;">Coming soon</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ 04 / APPROACH — cream ══ -->
  <section style="padding:96px 0;border-top:1px solid var(--border-cream);background:var(--cream);">
    <div style="max-width:1200px" class="mx-auto px-6">
      <div style="display:grid;grid-template-columns:repeat(12,1fr);gap:1.5rem;align-items:start;">
        <div style="grid-column:1/4;" class="reveal-fade-up">
          <span class="font-mono-label" style="color:var(--text-muted-cream);">04 / Approach</span>
        </div>
        <div style="grid-column:4/13;" class="reveal-slide-left flex flex-col gap-6">
          <h2 class="font-display" style="font-size:clamp(1.75rem,3.5vw,2.75rem);color:var(--text-on-cream);">How we think about research</h2>
          <p style="color:var(--text-muted-cream);font-size:1.0625rem;line-height:1.8;max-width:640px;">Most consulting research starts with a hypothesis and ends with a report. Ours starts in the field and ends when the problem is actually solved.</p>
          <p style="color:var(--text-muted-cream);font-size:1.0625rem;line-height:1.8;max-width:640px;">Because we work across the full arc — from network model integrity to crew adoption to control room readiness — we see failure modes that siloed researchers miss. The sensor that generates clean data but doesn't integrate with the GIS. The workflow that passes UAT but breaks in a storm. The vegetation model that's technically accurate but operationally useless.</p>
          <p style="color:var(--text-muted-cream);font-size:1.0625rem;line-height:1.8;max-width:640px;">That cross-functional view is the research. We're not studying one layer of the stack. We're studying what happens when all the layers have to work together under real conditions.</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBanner
    heading="Doing work in this space?"
    sub="We're open to comparing notes with operators, researchers, and builders working on adjacent problems."
    cta="Start a Conversation →"
    href="/contact"
  />

</Layout>

<style>
  @media (max-width: 767px) {
    [style*="grid-template-columns:repeat(12,1fr)"] {
      display: flex !important;
      flex-direction: column !important;
      gap: 1.5rem !important;
    }
    [style*="grid-column:"] {
      margin-top: 0 !important;
    }
    [style*="grid-template-columns:repeat(3,1fr)"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>
