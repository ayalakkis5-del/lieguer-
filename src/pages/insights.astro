---
import Layout from '../layouts/Layout.astro';
import CtaBanner from '../components/CtaBanner.astro';

const articles = [
  {
    title: 'What goes wrong in the 90 days before ADMS go-live (and how to spot it 6 months earlier)',
    excerpt: 'The failure patterns that show up at go-live almost always originate months earlier — in handoffs that looked fine on paper.',
  },
  {
    title: 'The five questions your GIS-to-ADMS integration testing isn\'t asking',
    excerpt: 'Standard integration test plans catch interface failures. The more dangerous gaps live in data semantics, topology assumptions, and edge-case operational scenarios.',
  },
  {
    title: 'Why crew adoption of field mobility tools fails — and it\'s not the tool',
    excerpt: 'Most mobile deployment failures trace back to workflow design, not technology. The app worked in the demo. The problem was the handoff it was supposed to replace.',
  },
];
---

<Layout
  title="Insights — GridSphere Utility Consulting"
  description="Notes from the gap between systems and the field — operational perspectives on ADMS, GIS, and field mobility for electric and gas utilities."
>
  <!-- ══ HERO ══ -->
  <section class="grid-overlay" style="padding:160px 0 96px;border-bottom:1px solid var(--border);background:var(--bg);">
    <div style="max-width:1200px;position:relative;z-index:1;" class="mx-auto px-6">
      <div class="hero-stagger flex flex-col gap-6" style="max-width:640px;">
        <span class="font-mono-label" style="color:var(--text-dim);font-size:0.65rem;">INSIGHTS</span>
        <h1 class="font-display" style="font-size:clamp(3rem,6vw,5rem);letter-spacing:-0.03em;font-weight:600;line-height:1.0;">Insights</h1>
        <p style="color:var(--text-muted);font-size:1.0625rem;line-height:1.75;">Notes from the gap between systems and the field.</p>
      </div>
    </div>
  </section>

  <!-- ══ ARTICLES — CREAM BREAK ══ -->
  <section style="padding:96px 0;border-top:1px solid var(--border-cream);background:var(--cream);">
    <div style="max-width:1200px" class="mx-auto px-6">
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border-cream);" class="stagger-children">
        {articles.map((article) => (
          <article class="cap-card reveal-fade-up flex flex-col gap-5" style="background:var(--cream-soft);border:1px solid var(--border-cream);">
            <div>
              <span class="font-mono-label" style="color:var(--text-muted-cream);font-size:0.65rem;border:1px solid var(--border-cream);padding:2px 8px;background:var(--cream-soft);">DRAFT</span>
            </div>
            <h2 class="font-display" style="font-size:1.2rem;font-weight:500;letter-spacing:-0.01em;line-height:1.35;color:var(--text-on-cream);">{article.title}</h2>
            <p style="color:var(--text-muted-cream);font-size:0.9rem;line-height:1.7;flex:1;">{article.excerpt}</p>
            <span class="font-mono-label" style="color:var(--text-muted-cream);font-size:0.65rem;margin-top:auto;">Coming soon</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner
    label="NEXT"
    heading="Want to talk through something specific?"
    sub="The things we write about are the things we work on. Let's connect."
    cta="Start a Conversation →"
    href="/contact"
  />
</Layout>

<style>
  @media (max-width: 767px) {
    [style*="grid-template-columns:repeat(3,1fr)"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>
