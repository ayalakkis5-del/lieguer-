---
import Layout from '../layouts/Layout.astro';
import CtaBanner from '../components/CtaBanner.astro';
---

<Layout
  title="Approach — GridSphere Utility Consulting"
  description="GridSphere was built on the belief that real grid modernization doesn't come from more tools. It comes from better alignment."
>
  <!-- ══ HERO ══ -->
  <section class="grid-overlay" style="padding:160px 0 96px;border-bottom:1px solid var(--border);background:var(--bg);">
    <div style="max-width:1200px;position:relative;z-index:1;" class="mx-auto px-6">
      <div class="hero-stagger flex flex-col gap-6" style="max-width:700px;">
        <span class="font-mono-label" style="color:var(--text-dim);font-size:0.65rem;">APPROACH</span>
        <h1 class="font-display" style="font-size:clamp(3rem,6vw,5rem);letter-spacing:-0.03em;font-weight:600;line-height:1.0;">Approach</h1>
        <p style="color:var(--text-muted);font-size:1.0625rem;line-height:1.75;">
          GridSphere was built on the belief that real grid modernization doesn't come from more tools. It comes from better alignment.
        </p>
      </div>
    </div>
  </section>

  <!-- ══ 01 / PHILOSOPHY — navy ══ -->
  <section style="padding:96px 0;border-top:1px solid var(--border);background:var(--bg);">
    <div style="max-width:1200px" class="mx-auto px-6">
      <div style="display:grid;grid-template-columns:repeat(12,1fr);gap:1.5rem;align-items:start;">
        <div style="grid-column:1/4;" class="reveal-fade-up">
          <span class="font-mono-label" style="color:var(--text-dim);font-size:0.65rem;">01 / PHILOSOPHY</span>
        </div>
        <div style="grid-column:4/13;" class="reveal-slide-left">
          <h2 class="font-display mb-8" style="font-size:clamp(1.75rem,3.5vw,2.75rem);letter-spacing:-0.02em;font-weight:500;color:var(--text);">
            We tell the truth, even when it's uncomfortable.
          </h2>
          <p style="color:var(--text-muted);font-size:1.0625rem;line-height:1.8;max-width:600px;">
            We understand how field realities, business priorities, and vendor narratives collide — and we know when to challenge what doesn't make sense. Long-term outcomes are worth more than short-term milestones, and we'd rather flag a problem early than help paper over one until go-live. That's the work. That's the whole job.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ 02 / EDGE — surface ══ -->
  <section style="padding:96px 0;border-top:1px solid var(--border);background:var(--surface);">
    <div style="max-width:1200px;position:relative;z-index:1;" class="mx-auto px-6">
      <div style="display:grid;grid-template-columns:repeat(12,1fr);gap:1.5rem;align-items:start;">
        <div style="grid-column:1/4;" class="reveal-fade-up">
          <span class="font-mono-label" style="color:var(--text-dim);font-size:0.65rem;">02 / EDGE</span>
        </div>
        <div style="grid-column:4/13;" class="reveal-slide-left">
          <h2 class="font-display mb-8" style="font-size:clamp(1.75rem,3.5vw,2.75rem);letter-spacing:-0.02em;font-weight:500;color:var(--text);">
            System fluency meets operational empathy.
          </h2>
          <p style="color:var(--text-muted);font-size:1.0625rem;line-height:1.8;max-width:600px;">
            From network model design to field readiness, we bring a rare mix: the technical depth to understand your stack, and the operational experience to know what actually happens when those systems meet a truck, a crew, and a storm. We act as your second set of eyes — your strategic filter, your translator across silos, and an advocate for outcomes that hold up after the consultants leave.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ 03 / FOUNDER — CREAM BREAK ══ -->
  <section style="padding:96px 0;border-top:1px solid var(--border-cream);background:var(--cream);">
    <div style="max-width:1200px" class="mx-auto px-6">
      <div class="reveal-fade-up mb-14">
        <span class="font-mono-label" style="color:var(--text-muted-cream);font-size:0.65rem;">03 / FOUNDER</span>
      </div>
      <div style="display:grid;grid-template-columns:repeat(12,1fr);gap:1.5rem;align-items:start;">

        <!-- Portrait: col 1-4 -->
        <div style="grid-column:1/4;" class="reveal-fade-up">
          <div
            style="aspect-ratio:4/5;background:var(--cream-soft);border:1px solid var(--border-cream);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1rem;"
            aria-hidden="true"
          >
            <!-- Drop headshot at /public/aya.jpg and replace this div with:
                 <img src="/aya.jpg" alt="Aya Lakkis, Founder & Principal of GridSphere" style="width:100%;height:100%;object-fit:cover;" />
            -->
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--border-cream)" stroke-width="1">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
            <span class="font-mono-label" style="color:var(--text-muted-cream);font-size:0.65rem;">PORTRAIT</span>
          </div>
        </div>

        <!-- Bio: col 4-13 -->
        <div style="grid-column:4/13;" class="reveal-slide-left flex flex-col gap-6">
          <div>
            <h2 class="font-display" style="font-size:clamp(2rem,3.5vw,3rem);letter-spacing:-0.02em;font-weight:500;color:var(--text-on-cream);">Aya Lakkis</h2>
            <span class="font-mono-label mt-3 block" style="color:var(--text-muted-cream);font-size:0.65rem;">Founder &amp; Principal</span>
          </div>
          <p style="color:var(--text-muted-cream);font-size:1.0625rem;line-height:1.8;">
            GridSphere was founded by Aya Lakkis, a utility consultant with nearly a decade of experience supporting electric and gas utilities through digital grid transformation, ADMS implementations, GIS modernization, and field mobility programs.
          </p>
          <p style="color:var(--text-muted-cream);font-size:1.0625rem;line-height:1.8;">
            Her background spans the full delivery arc — from configuring systems in test environments to standing with field crews during outage events, to presenting program risk to executive leadership. She holds a graduate certificate in Geospatial Intelligence from Johns Hopkins University and has led work across data quality, network model readiness, integration testing, and operational rollout.
          </p>
          <p style="color:var(--text-muted-cream);font-size:1.0625rem;line-height:1.8;">
            She founded GridSphere on a simple premise: the gap between what utility systems claim and what utility crews experience is where most modernization programs quietly fail — and closing that gap is a discipline, not an accident.
          </p>
          <a
            href="https://www.linkedin.com/in/ayalakkis/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Aya Lakkis on LinkedIn"
            style="display:inline-flex;align-items:center;gap:0.5rem;width:fit-content;color:var(--text-muted-cream);text-decoration:none;transition:color 0.2s ease;"
            onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text-muted-cream)'"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect x="2" y="9" width="4" height="12"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
            <span class="font-mono-label" style="font-size:0.65rem;color:inherit;">LinkedIn</span>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ══ PULL QUOTE — navy, signature color ══ -->
  <section style="padding:96px 0;background:var(--bg);border-top:1px solid var(--border);overflow:hidden;">
    <div style="max-width:1200px" class="mx-auto px-6">
      <div style="display:grid;grid-template-columns:repeat(12,1fr);gap:1.5rem;">
        <div style="grid-column:2/12;" class="reveal-scale-slow">
          <p
            class="font-display"
            style="font-size:clamp(4rem,12vw,10rem);font-weight:500;letter-spacing:-0.04em;color:var(--signature);line-height:0.95;font-style:italic;margin:0;"
            aria-label="We protect outcomes."
          >
            We protect outcomes.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CtaBanner
    label="NEXT"
    heading="Ready to align your systems and your crews?"
    sub="Tell us what's misaligned. We'll tell you whether we're the right fit."
    cta="Start a Conversation →"
    href="/contact"
  />
</Layout>

<style>
  @media (max-width: 767px) {
    [style*="grid-template-columns:repeat(12,1fr)"] {
      display: flex !important;
      flex-direction: column !important;
      gap: 1.5rem !important;
    }
    [style*="grid-column:"] {
      margin-top: 0 !important;
    }
  }
</style>
